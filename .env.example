# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend olay webhook — production build'de zorunlu (yoksa emitZineshEvent no-op).
# Örnek: https://www.zinesh.com/api/events.php
VITE_ZINESH_EVENT_WEBHOOK_URL=

# Deploy — yerel makinede secrets/deploy.local.env dosyasına yazın (GitHub'a gitmez)
# Örnek: secrets/deploy.local.example.env dosyasını kopyalayın

VITE_API_BASE_URL=https://www.zinesh.com
