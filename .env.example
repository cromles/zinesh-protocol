# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend olay webhook — production build'de zorunlu (yoksa emitZineshEvent no-op).
# Örnek: https://www.zinesh.com/api/events.php
VITE_ZINESH_EVENT_WEBHOOK_URL=

# Deploy — yerel makinede secrets/deploy.local.env dosyasına yazın (GitHub'a gitmez)
# Örnek: secrets/deploy.local.example.env dosyasını kopyalayın

# Yerel demo API (npm run demo:api ile birlikte kullanın)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787
# VITE_DEMO_MODE=1

VITE_API_BASE_URL=https://www.zinesh.com

# Firebase Web SDK (Vite: NEXT_PUBLIC_* → VITE_*)
# Firebase Console → Authentication → Sign-in method → Phone: Enable
# Authorized domains: www.zinesh.com, app.zinesh.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=
