# Zinesh sunucu girisi — sablon (GitHub'a gider)
# Kullanim: copy secrets\deploy.local.example.env secrets\deploy.local.env

ZINESH_DEPLOY_HOST=SUNUCU_IP_VEYA_DOMAIN
ZINESH_DEPLOY_USER=root

# SSH private key (tercih edilen) — absolute path, repo disinda tutun
# Ornek Windows: ZINESH_DEPLOY_KEY=C:\Users\KULLANICI\.ssh\zinesh_admin
# Ornek Linux/macOS: ZINESH_DEPLOY_KEY=/home/kullanici/.ssh/zinesh_admin
# ZINESH_DEPLOY_KEY=

# Sifreli anahtar icin (sadece secrets/deploy.local.env — buraya gercek deger yazmayin)
# ZINESH_DEPLOY_KEY_PASSPHRASE=

# Gecis donemi: key yoksa veya bulunamazsa parola fallback
ZINESH_DEPLOY_PASS=SSH_SIFRENIZ

# Ops scriptleri (kurucu sifre / TOTP / certbot)
ZINESH_FOUNDER_EMAIL=kurucu@example.com
ZINESH_CERTBOT_EMAIL=admin@example.com

ZINESH_WWW_ROOT=/www/wwwroot/zinesh.com
ZINESH_APP_ROOT=/www/wwwroot/app.zinesh.com
ZINESH_REMOTE_API=/www/wwwroot/zinesh.com/api

# Google Drive rclone OAuth (tek seferlik — secrets/deploy.local.env kullanin, buraya yazmayin)
# ZINESH_RCLONE_OAUTH_TOKEN={"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}